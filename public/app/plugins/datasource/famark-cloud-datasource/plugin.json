    },
    "keywords": [
      "json",
      "api"
    ],
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "links": [
      {
        "name": "Documentation",
        "url": "https://grafarg.github.io/famark-cloud-datasource"
      },
      {
        "name": "Website",
        "url": "https://github.com/famarks/famark-cloud-datasource"
      },
      {
        "name": "License",
        "url": "https://github.com/famarks/famark-cloud-datasource/blob/main/LICENSE"
      }
    ],
    "screenshots": [
      {
        "name": "Explore (Dark)",
        "path": "img/dark.png"
      },
      {
        "name": "Explore (Light)",
        "path": "img/light.png"
      }
    ],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "dependencies": {
    "grafargDependency": ">=8.5.13",
